{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assembly-manifest.schema.json",
  "title": "Crisis Liturgies Assembly Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "volume_id", "page_count", "output_pdf", "output_sha256", "authoritative_text_in_image", "records"],
  "properties": {
    "status": {"const": "ASSEMBLED"},
    "volume_id": {"type": "string", "minLength": 1},
    "page_count": {"type": "integer", "minimum": 1},
    "output_pdf": {"type": "string", "minLength": 1},
    "output_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "authoritative_text_in_image": {"const": false},
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["page_id", "asset", "copy_sha256", "body_font", "metadata_font", "body_size", "body_leading"],
        "properties": {
          "page_id": {"type": "string", "minLength": 1},
          "asset": {"type": ["string", "null"]},
          "copy_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "body_font": {"type": "string", "minLength": 1},
          "metadata_font": {"type": "string", "minLength": 1},
          "body_size": {"type": "number", "exclusiveMinimum": 0},
          "body_leading": {"type": "number", "exclusiveMinimum": 0}
        }
      }
    }
  }
}
